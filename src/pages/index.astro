---
import BaseLayout from '../layouts/BaseLayout.astro';
import Terminal from '../components/Terminal.astro';
import SectionHead from '../components/SectionHead.astro';
import PixelIcon from '../components/PixelIcon.astro';
import PostCard from '../components/PostCard.astro';
import type { IconName } from '../components/pixel-matrices';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = posts.slice(0, 5);

const pixels: { name: IconName; label: string }[] = [
  { name: 'chip', label: 'STM32' },
  { name: 'terminal', label: 'tty' },
  { name: 'keyboard', label: 'kbd' },
  { name: 'coffee', label: 'coffee' },
  { name: 'board', label: 'pcb' },
  { name: 'led', label: 'LED' },
];
---
<BaseLayout title="tomsawyer@blog:~$">
  <Terminal title="tomsawyer@blog: ~">
    <div class="t-line"><span class="t-prompt">$</span> whoami</div>
    <div class="t-out">我是tomsawyer —— 一个忧郁的boy</div>
    <div class="t-line"><span class="t-prompt">$</span> why build a blog?</div>
    <div class="t-out">因为我想记录我的思考和学习过程。</div>
    <div class="t-line"><span class="t-prompt">$</span> what plan to write here in the future?</div>
    <div class="t-out">不知道，随便写写吧！</div>
  </Terminal>

  <div class="pixel-row">
    {pixels.map((p) => (
      <div class="pixel-item">
        <PixelIcon name={p.name} />
        <span class="pixel-label">{p.label}</span>
      </div>
    ))}
  </div>

  <SectionHead cmd="ls ~/posts" comment="最新文章" />
  <div class="post-list">
    {latest.map((p, i) => (
      <PostCard
        num={i + 1}
        slug={p.id}
        title={p.data.title}
        date={p.data.date}
        category={p.data.category}
        summary={p.data.summary}
      />
    ))}
  </div>
  <div class="list-more">
    <a href="/blog/" class="more-link">cd ~/blog <span class="arrow">→</span> 查看全部文章</a>
  </div>
</BaseLayout>

<style>
  .t-line {
    color: var(--term-text);
  }
  .t-prompt {
    color: var(--accent);
    font-weight: 700;
    margin-right: 6px;
  }
  .t-out {
    color: var(--term-dim);
  }
  .t-cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    background: var(--accent);
    vertical-align: text-bottom;
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .pixel-row {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
    margin: 26px 0 6px;
  }
  .pixel-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .pixel-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }
  .list-more {
    padding: 26px 10px;
    text-align: right;
  }
  .more-link {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    transition: color 0.2s;
  }
  .more-link:hover {
    color: var(--accent-dark);
  }
</style>